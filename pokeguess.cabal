cabal-version:      2.4
name:               pokeguess
version:            0.1.0.0
synopsis:           A "Who's that Pokémon?" web game built with Scotty
description:
  PokéGuess is a web service built with Haskell and Scotty.
  Players guess Pokémon by silhouette/name, earn points, and build teams.
  Integrates with the PokéAPI for Pokémon data.
license:            MIT
author:             Gabriel
maintainer:         gabriel@example.com
category:           Web, Game
build-type:         Simple
extra-source-files: README.md

-- ───────────────────────────────────────────────
-- Biblioteca principal (lógica pura + integração)
-- ───────────────────────────────────────────────
library
  hs-source-dirs:     src
  exposed-modules:
      Game
    , Score
    , Team
    , PokeAPI
  build-depends:
      base              >= 4.14
    , text              >= 1.2
    , aeson             >= 2.0
    , http-conduit      >= 2.3
    , http-client       >= 0.7
    , http-client-tls   >= 0.3
    , containers        >= 0.6
    , random            >= 1.2
    , bytestring        >= 0.10
  default-language:   Haskell2010
  default-extensions: OverloadedStrings
  ghc-options:        -Wall

-- ───────────────────────────────────────────────
-- Executável principal (servidor Scotty)
-- ───────────────────────────────────────────────
executable pokeguess
  hs-source-dirs:     app
  main-is:            Main.hs
  build-depends:
      base              >= 4.14
    , pokeguess
    , scotty            >= 0.12
    , wai               >= 3.2
    , warp              >= 3.3
    , text              >= 1.2
    , aeson             >= 2.0
    , containers        >= 0.6
    , stm               >= 2.5
    , random            >= 1.2
  default-language:   Haskell2010
  default-extensions: OverloadedStrings
  ghc-options:        -Wall -threaded -rtsopts -with-rtsopts=-N

-- ───────────────────────────────────────────────
-- Suite de testes (HUnit)
-- ───────────────────────────────────────────────
test-suite pokeguess-test
  type:               exitcode-stdio-1.0
  hs-source-dirs:     test
  main-is:            Spec.hs
  build-depends:
      base              >= 4.14
    , pokeguess
    , HUnit             >= 1.6
    , text              >= 1.2
  default-language:   Haskell2010
  ghc-options:        -Wall
